# Copy to .env and adjust. Every value here is optional — with no .env at all
# the project runs on SQLite with an ephemeral secret key, which is enough for
# local development, tests and a demo.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True

# --- Database ---
# Leave DB_NAME blank to use SQLite (backend/netforensiq.sqlite3).
# Set it to switch to PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Override only if you need a non-PostgreSQL server engine.
DB_ENGINE=django.db.backends.postgresql

# --- Evidence storage ---
# Where ingested PCAPs and generated certificates are written.
MEDIA_ROOT=
