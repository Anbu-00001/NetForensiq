# Copy to .env and adjust. Every value here is optional — with no .env at all
# the project runs on SQLite with an ephemeral secret key, which is enough for
# local development, tests and a demo.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True

# --- Database ---
# Leave DB_NAME blank to use SQLite (backend/netforensiq.sqlite3).
# Set it to switch to PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Override only if you need a non-PostgreSQL server engine.
DB_ENGINE=django.db.backends.postgresql

# --- Evidence storage ---
# Where ingested PCAPs and generated certificates are written.
MEDIA_ROOT=

# --- Deployment identity ---
# Hostnames this instance answers on. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Exhibit and certificate identifier prefixes. Most units have their own
# exhibit numbering; ours should not appear on documents that go into a
# case file.
EXHIBIT_PREFIX=NF
CERTIFICATE_PREFIX=S63

# Printed on the Section 63 certificate as the issuing body. Blank prints
# nothing rather than inventing an organisation.
ISSUING_ORGANISATION=

# --- Cache ---
# DRF's throttle counters live here, so this decides whether the login rate
# limit is real. The file-based default is shared between processes and
# survives restarts; point it at Redis or Memcached in a deployment.
CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
CACHE_LOCATION=

# Alternate SQLite file, so a clean-start check can run without clobbering
# the database you have been working in.
SQLITE_NAME=
